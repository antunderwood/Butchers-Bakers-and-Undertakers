// Cloudflare Worker serving the site as static assets: no Worker script, no build step.
// Workers Builds deploys on every push to main; .assetsignore keeps the design working files out.
{
  "name": "allhs-bbu",
  "compatibility_date": "2026-10-04",
  "assets": {
    "directory": "."
  },
  "routes": [
    { "pattern": "allhs-bbu.flying-ant.uk", "custom_domain": true }
  ],
  "workers_dev": false
}
